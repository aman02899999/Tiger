# Firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# There is deliberately no VITE_* admin password. Any secret shipped to the
# browser is public. Privileged actions live behind:
#   • custom claims (role/gymId) set by Cloud Functions or the bootstrap script
#   • functions/ scripts/bootstrap-admin.mjs  (one-time first platform admin)
#   • Cloud Functions secrets: RAZORPAY_KEY_ID, RAZORPAY_KEY_SECRET,
#     RAZORPAY_WEBHOOK_SECRET  — set with `firebase functions:secrets:set`

# External APIs
VITE_OPENWEATHER_API_KEY=
VITE_AQI_API_KEY=
VITE_GEOCODING_API_KEY=
VITE_EXERCISE_API_KEY=
VITE_CURRENCY_API_KEY=
