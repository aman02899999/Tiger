# ═══════════════════════════════════════════════════════════════════
#  Tiger — environment template
#  Copy to `.env.local` (git-ignored) and fill in from
#  Firebase Console → Project settings → Your apps → Web app → Config.
#
#  These values are NOT secrets: a Firebase web config ships inside every
#  browser bundle. The security boundary is `firestore.rules`,
#  `storage.rules` and custom claims. Real secrets live in Cloud Functions
#  Secret Manager — never here, and never with a VITE_ prefix.
#
#  Check your work with:  npm run check:firebase
# ═══════════════════════════════════════════════════════════════════

# ── Required: without all six the app runs the labelled demo workspace ──
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=

# Two valid forms; copy the exact one the console shows for your project.
#   projects created before late 2024:  <project-id>.appspot.com
#   projects created after:             <project-id>.firebasestorage.app
VITE_FIREBASE_STORAGE_BUCKET=

VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Optional ───────────────────────────────────────────────────────
# Analytics only. Safe to omit — auth, data and storage are unaffected.
VITE_FIREBASE_MEASUREMENT_ID=

# External providers, off unless you set them. The coaching loop does not
# need any of these; see docs/API_INTEGRATIONS.md for what is verified.
# VITE_OPENWEATHER_API_KEY=
# VITE_AQI_API_KEY=
# VITE_GEOCODING_API_KEY=
# VITE_EXERCISE_API_KEY=
# VITE_CURRENCY_API_KEY=

# There is deliberately no VITE_* admin password. A password shipped to the
# browser is public. Privileged actions require a custom claim set by the
# trusted backend (`functions/`), and the first platform admin is created
# once by `node functions/scripts/bootstrap-admin.mjs you@example.com`.
#
# Cloud Functions secrets (set with `firebase functions:secrets:set`):
#   RAZORPAY_KEY_ID
#   RAZORPAY_KEY_SECRET
#   RAZORPAY_WEBHOOK_SECRET
