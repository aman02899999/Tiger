# ---------------------------------------------------------------
# Razorpay — payment gateway
# ---------------------------------------------------------------
# Only the PUBLIC Key ID goes here (it is safe to expose in the frontend).
# Get it from the Razorpay Dashboard → Settings → API Keys.
# It looks like: rzp_test_XXXXXXXXXXXXXX (test) or rzp_live_XXXXXXXXXXXXXX (live)
VITE_RAZORPAY_KEY_ID=

# NEVER put your Razorpay KEY SECRET in this file or any frontend/VITE_ variable.
# The secret must live only on a backend/cloud function that creates orders
# and verifies payment signatures. Exposing it compromises your account.
#
# To activate: copy this file to `.env`, paste your Key ID, and restart the dev
# server (or set VITE_RAZORPAY_KEY_ID in your hosting provider's env settings).
# When unset, the app uses a simulated checkout so the flow stays testable.
