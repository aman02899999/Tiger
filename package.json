{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-3d.mjs && vite build",
    "preview": "vite preview",
    "check:3d": "node scripts/check-3d.mjs",
    "check:firebase": "node scripts/check-firebase.mjs",
    "check:indexes": "node scripts/gen-indexes.mjs --check",
    "gen:indexes": "node scripts/gen-indexes.mjs",
    "typecheck": "tsc -b --noEmit",
    "typecheck:functions": "npm --prefix functions run typecheck",
    "test": "node scripts/test-insights.mjs && node scripts/test-saas.mjs",
    "test:insights": "node scripts/test-insights.mjs",
    "test:saas": "node scripts/test-saas.mjs",
    "verify": "npm run typecheck && npm test && npm run build",
    "fb": "npx --yes firebase-tools@latest",
    "emulators": "npm run fb -- emulators:start",
    "deploy:rules": "npm run fb -- deploy --only firestore:rules,storage:rules,firestore:indexes",
    "deploy:hosting": "npm run build && npm run fb -- deploy --only hosting",
    "deploy:functions": "npm run fb -- deploy --only functions",
    "deploy:all": "npm run build && npm run fb -- deploy --only firestore:rules,storage:rules,firestore:indexes,functions,hosting",
    "logs": "npm run fb -- functions:log"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "clsx": "2.1.1",
    "firebase": "^12.14.0",
    "framer-motion": "^12.42.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0"
  }
}
