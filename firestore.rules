    function isSignedIn() {
      return request.auth != null;
    }

    function hasRole(role) {
      return isSignedIn() && request.auth.token.role == role;
    }

    function isSuperAdmin() {
      return hasRole('super_admin');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSameGym(gymId) {
      return isSignedIn() && request.auth.token.gymId == gymId;
    }

    function trainerRelationshipId(clientId) {
      return request.auth.token.gymId + '_' + request.auth.uid + '_' + clientId;
    }

    function isActiveTrainerOf(clientId) {
      return hasRole('trainer')
        && exists(/databases/$(database)/documents/trainerClients/$(trainerRelationshipId(clientId)))
        && get(/databases/$(database)/documents/trainerClients/$(trainerRelationshipId(clientId))).data.status == 'active';
    }

    function profileCreateIsSafe(userId) {
      return request.resource.data.keys().hasOnly([
        'id', 'name', 'email', 'avatar', 'phone', 'age', 'gender', 'height',
        'weight', 'goal', 'plan', 'joinDate', 'streak', 'onboardingComplete',
        'preferences', 'stats'
      ]) && request.resource.data.id == userId && request.resource.data.plan == 'Free';
    }

    function profileUpdateIsSafe() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'name', 'avatar', 'phone', 'age', 'gender', 'height', 'weight', 'goal',
        'streak', 'onboardingComplete', 'preferences', 'stats'
      ]);
    }
||||||| base
=======
    function isSignedIn() {
      return request.auth != null;
    }

    function role() {
      return request.auth.token.role;
    }

    function isSuperAdmin() {
      return isSignedIn() && role() == 'super_admin';
    }

    function isGymOwner(gymId) {
      return isSignedIn() && role() == 'gym_owner' && request.auth.token.gymId == gymId;
    }

    function isTrainer() {
      return isSignedIn() && role() == 'trainer';
    }

    function isClient() {
      return isSignedIn() && role() == 'client';
    }

    function sameUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function trainerRelationshipAllowed(clientId, gymId) {
      return isTrainer() &&
        exists(/databases/$(database)/documents/trainerClients/${request.auth.uid}_${clientId}) &&
        get(/databases/$(database)/documents/trainerClients/${request.auth.uid}_${clientId}).data.gymId == gymId &&
        get(/databases/$(database)/documents/trainerClients/${request.auth.uid}_${clientId}).data.status == 'active';
    }

    function gymOwnerCanManageGym(gymId) {
      return isSignedIn() && isGymOwner(gymId);
    }
