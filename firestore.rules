    // Published course metadata is public. Only a server-issued super-admin
    // claim may manage course records; payment services create enrollments.
    match /courses/{courseId} {
      allow read: if resource.data.published == true || isSuperAdmin();
      allow create, update, delete: if isSuperAdmin();
    }

    match /courseEnrollments/{userId}/courses/{courseId} {
      allow read: if isOwner(userId) || isSuperAdmin();
      allow write: if false;
    }

    // Only trusted backend code may issue or revoke paid access.
    match /entitlements/{userId} {
      allow read: if isOwner(userId) || isSuperAdmin();
      allow write: if false;
    }

    // Challenge participation is scoped to the signed-in participant. Points
    // are non-financial app data and must not be used as entitlement evidence.
    match /challengeEntries/{challengeId}/participants/{userId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isOwner(userId);
    }

    // Trainer-client and gym resources are intentionally fail-closed until
    // custom claims, gym-scoped documents, and their application flows land.
    match /gyms/{gymId} {
      allow read, write: if false;
    }

    match /trainerClients/{relationshipId} {
      allow read: if isSuperAdmin()
        || (isSignedIn() && request.auth.uid == resource.data.trainerId && isSameGym(resource.data.gymId))
        || (isSignedIn() && request.auth.uid == resource.data.clientId && isSameGym(resource.data.gymId));
      allow write: if false;
||||||| base
      allow read, delete: if request.auth != null && request.auth.token.email == 'admin@tigerfitpro.in';
=======
      allow read, delete: if isSignedIn() && isSuperAdmin();
>>>>>>> theirs
    }
  }
