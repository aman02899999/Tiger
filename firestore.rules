rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can read/write their own profile — EXCEPT the `plan` field, which
    // may only be granted a paid tier by the backend (Cloud Functions use the
    // Admin SDK and bypass these rules). Clients may keep it unchanged or set
    // it to "Free" (onboarding/downgrade), never self-upgrade to Pro/Elite.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && (!('plan' in request.resource.data) || request.resource.data.plan == 'Free');
      allow update: if request.auth != null && request.auth.uid == userId
        && (!('plan' in request.resource.data)
            || request.resource.data.plan == resource.data.plan
            || request.resource.data.plan == 'Free');
      allow delete: if request.auth != null && request.auth.uid == userId;

      // Sub-collections (payments audit trail, etc.) — owner-scoped.
      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Blog posts: anyone can read, only admins can write
    match /blogs/{blogId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'admin@tigerfitpro.in';
    }

    // Newsletter subscribers: anyone can create, only admins can read/delete
    match /subscribers/{email} {
      allow create: if true;
      allow read, delete: if request.auth != null && request.auth.token.email == 'admin@tigerfitpro.in';
    }
  }
}
