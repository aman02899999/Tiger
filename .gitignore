node_modules/
dist/
.firebase/

# Environment files — per-machine configuration, and the place a future
# contributor will inevitably paste a real secret. Never commit them.
.env
.env.*
!.env.example

tsconfig.tsbuildinfo
.claude/worktrees/

# Android (TWA) build outputs and secrets — never commit signing material.
android/.gradle/
android/app/build/
android/build/
android/local.properties
android/android.keystore
android/*.keystore
android/gradle/wrapper/gradle-wrapper.jar
android/key.properties

# Local visual preview artifact (generated, not source)
.preview/

# Archived audit logs — kept on disk for reference, not tracked (134 MB).
docs/audit-archive/

# Local test build output
.test-build/
.indexes-build/

# Firebase doctor scratch build
.firebase-check-build/
